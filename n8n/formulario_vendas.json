    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst custo = Number(j['Custo']);\nconst vendas = Number(j['Vendas']);\nconst data = new Date(j['Data']);\nconst erros = [];\n\nif (isNaN(data.getTime())) erros.push('Data inválida.');\nelse if (data.getFullYear() < 2000 || data > new Date()) erros.push('Data fora do intervalo permitido (2000 até hoje).');\nif (!(custo >= 0)) erros.push('Custo deve ser um número maior ou igual a zero.');\nif (!(vendas > 0)) erros.push('Vendas deve ser um número maior que zero.');\n\nif (erros.length) throw new Error('Registro recusado: ' + erros.join(' '));\n\nconst iso = data.toISOString().slice(0, 10);\nreturn [{ json: {\n  Data: iso,\n  Categoria: j['Categoria'],\n  Regiao: j['Região'],\n  Custo: Number(custo.toFixed(2)),\n  Vendas: Number(vendas.toFixed(2)),\n  Lucro: Number((vendas - custo).toFixed(2))\n}}];"
      },
